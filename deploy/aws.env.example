# Rampart on AWS — backend environment surface.
#
# Copy to `aws.env`, fill in, and load it into your AWS service:
#   - ECS Fargate: paste into the task-definition env (DATABASE_URL +
#     RAMPART_SECRET_KEY via Secrets Manager, not plaintext).
#   - EC2 + compose: `docker compose --env-file aws.env -f deploy/compose.aws.yaml up -d`.
#
# See docs/DEPLOY.md for the full per-variable reference.

# --- required ---------------------------------------------------------------

# RDS / Aurora PostgreSQL. sqlx reads sslmode (+ sslrootcert) from the URL, so
# `?sslmode=require` works with no code change. URL-encode special chars in the
# password (@ / : #).
DATABASE_URL=postgres://rampart:CHANGE-ME@your-instance.xxxx.us-east-1.rds.amazonaws.com:5432/rampart?sslmode=require

# --- recommended ------------------------------------------------------------

# 32-byte hex. Enables AES-256-GCM encryption-at-rest for channel/SMTP secrets.
#   openssl rand -hex 32
RAMPART_SECRET_KEY=

# Refuse to start without a valid RAMPART_SECRET_KEY. Belt-and-suspenders.
# RAMPART_REQUIRE_SECRET_KEY=1

# Structured JSON logs for CloudWatch / log aggregators.
RAMPART_LOG_FORMAT=json

# Behind an ALB / proxy you MUST set this to the proxy's specific IP (or /32)
# or per-client rate-limit + audit IPs collapse to the load balancer.
# RAMPART_TRUSTED_PROXIES=10.0.1.5

# --- optional ---------------------------------------------------------------

# BIND_ADDR=0.0.0.0:3000                 # image default; leave as is
# DATABASE_POOL_SIZE=16                   # ensure RDS allows pool_size x replicas
# RUST_LOG=rampart=info,tower_http=warn,info
# RAMPART_RLS=1                           # Postgres row-level tenant isolation
# RAMPART_MULTI_ORG=1                     # reject ingest with no matching org key

# First-admin bootstrap (read only by `rampart-api seed-demo`, and only when the
# users table is empty). Leave unset to use the first-run signup form instead.
# RAMPART_ADMIN_EMAIL=admin@example.com
# RAMPART_ADMIN_PASSWORD=

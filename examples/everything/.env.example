# Copy to .env and tweak as desired, then `docker compose up`.

# Admin login created on first run (the provisioner registers it).
RAMPART_ADMIN_EMAIL=demo@rampart.local
RAMPART_ADMIN_PASSWORD=Rampart-Live-9271

# Rampart image. Default is the published image. To build from this repo:
#   set RAMPART_IMAGE= (empty), uncomment `build:` on the rampart service, then
#   `docker compose build rampart && docker compose up`.
RAMPART_IMAGE=ghcr.io/pen-pal/rampart:latest

# 32-byte key (64 hex chars) → AES-256-GCM encryption of channel secrets at rest.
# UNSET by default so the demo's real channel deliveries work end-to-end (see the
# note on the rampart service in docker-compose.yml + README "Known caveats").
# To demo encryption-at-rest, uncomment with a real key:  openssl rand -hex 32
# RAMPART_SECRET_KEY=

# --- OIDC (only used with `--profile oidc`; points Rampart at the Dex service) ---
# Uncomment these (in .env) when running the oidc profile:
# RAMPART_OIDC_ISSUER=http://localhost:5556/dex
# RAMPART_OIDC_CLIENT_ID=rampart
# RAMPART_OIDC_CLIENT_SECRET=rampart-oidc-secret
# RAMPART_OIDC_REDIRECT_URL=http://localhost:3000/v1/auth/oidc/callback
# RAMPART_OIDC_DEFAULT_ROLE=editor

{
  "name": "rampart-everything-demo-backend",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "description": "Instrumented sample backend that ships REAL telemetry (traces, logs, metrics, profiles, errors) to Rampart",
  "scripts": {
    "start": "node -r ./otel.js server.js",
    "build": "node --check otel.js && node --check server.js && echo syntax-ok"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-logs": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@sentry/node": "^8.47.0",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3"
  }
}

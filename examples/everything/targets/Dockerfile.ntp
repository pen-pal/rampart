# Minimal NTP server for the `heavy · ntp` monitor. alpine's chrony serves NTP
# on udp/123. The previously-referenced cturl/ntp image was unpublished (404),
# and dockurr/chrony needs bash + env config it doesn't ship — so we build a
# tiny, self-contained server here instead.
FROM alpine:3.20
RUN apk add --no-cache chrony \
 && mkdir -p /var/lib/chrony /run/chrony \
 && printf '%s\n' \
      'server pool.ntp.org iburst' \
      'local stratum 8' \
      'allow all' \
      'driftfile /var/lib/chrony/drift' \
      'rtcsync' \
      'cmdport 0' \
    > /etc/chrony/chrony.conf
EXPOSE 123/udp
# -d foreground, -x = don't try to discipline the (container) clock; just answer
# NTP queries so the probe gets a valid reply even without CAP_SYS_TIME.
CMD ["chronyd", "-d", "-x"]

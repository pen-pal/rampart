# Rampart · environment configuration
#
# Copy to `.env` and edit. `docker compose up` reads this automatically.

# Postgres connection string. Override the password before going to prod.
DATABASE_URL=postgres://rampart:rampart@localhost:5432/rampart

# Pool size. Default 16. Raise for production; Postgres should allow at least
# (pool_size * number_of_api_replicas) connections.
DATABASE_POOL_SIZE=16

# HTTP bind address. Use 127.0.0.1:3000 if you front this with a reverse proxy
# on the same host.
BIND_ADDR=0.0.0.0:3000

# Tracing filter. Examples:
#   RUST_LOG=info                          everything at info
#   RUST_LOG=rampart=debug,info             debug for our crates, info elsewhere
#   RUST_LOG=rampart_api=trace,sqlx=warn    very verbose API, quiet sqlx
RUST_LOG=rampart=info,tower_http=info,info

# The React frontend bundle (output of `npm run build` in ../frontend) is
# embedded into the binary via `rust-embed`. In debug builds rust-embed reads
# from disk at request time, so a `npm run build` + browser refresh is enough
# during dev. Release builds bake the bytes in — `rampart-api` ships as one
# self-contained executable, no STATIC_DIR / asset paths needed.

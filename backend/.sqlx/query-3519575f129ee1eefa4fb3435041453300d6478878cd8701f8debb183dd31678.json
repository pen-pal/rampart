  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, project_id, fingerprint, title, culprit, level, status,\n               first_seen, last_seen, times_seen, assignee\n        FROM error_issues\n        WHERE status = 'open'\n        ORDER BY last_seen DESC\n        LIMIT $1\n        ",

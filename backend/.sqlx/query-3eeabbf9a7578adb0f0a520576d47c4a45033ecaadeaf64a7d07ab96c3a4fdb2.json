  "db_name": "PostgreSQL",
  "query": "\n        SELECT ts, user_id, session, ua, trace_id, lcp_ms, inp_ms, cls, load_ms\n        FROM rum_events\n        WHERE url = $1\n          AND received_at > now() - make_interval(hours => $2)\n          AND ($3::text IS NULL OR app = $3)\n        ORDER BY ts DESC\n        LIMIT $4\n        ",

  "db_name": "PostgreSQL",
  "query": "\n        SELECT url, trace_id AS \"trace_id!\", load_ms, ts\n        FROM rum_events\n        WHERE trace_id IS NOT NULL\n          AND received_at > now() - make_interval(hours => $1)\n          AND ($2::text IS NULL OR app = $2)\n        ORDER BY ts DESC\n        LIMIT $3\n        ",

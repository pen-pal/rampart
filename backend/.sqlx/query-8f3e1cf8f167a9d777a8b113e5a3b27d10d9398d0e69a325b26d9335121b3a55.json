  "query": "\n        SELECT id, name, recipients, cadence, last_sent_at, created_at\n        FROM scheduled_reports\n        WHERE last_sent_at IS NULL\n           OR last_sent_at <= $1::timestamptz - interval '7 days'\n        ",

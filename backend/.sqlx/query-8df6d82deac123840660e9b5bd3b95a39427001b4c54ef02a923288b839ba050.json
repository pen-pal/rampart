{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            monitor_id,\n            (date_trunc('month', ts AT TIME ZONE 'UTC'))::date AS \"month!\",\n            COUNT(*)                              AS \"total!\",\n            COUNT(*) FILTER (WHERE status = 'up') AS \"up!\"\n        FROM heartbeats\n        WHERE monitor_id = ANY($1) AND ts >= $2\n        GROUP BY monitor_id, (date_trunc('month', ts AT TIME ZONE 'UTC'))::date\n        ",

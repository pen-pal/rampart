{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT nt.notification_id, t.id AS tag_id, t.name, t.color\n        FROM notification_tags nt\n        JOIN tags t ON t.id = nt.tag_id\n        WHERE nt.notification_id = ANY($1)\n        ORDER BY t.name\n        ",

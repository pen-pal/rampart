{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            monitor_id,\n            ts,\n            status AS \"status: MonitorStatus\",\n            latency_ms,\n            status_code,\n            msg,\n            retries,\n            important\n        FROM heartbeats\n        WHERE monitor_id = $1\n          AND ($3::timestamptz IS NULL OR ts < $3)\n        ORDER BY ts DESC\n        LIMIT $2\n        ",

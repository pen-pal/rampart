  "query": "\n        SELECT mt.monitor_id, t.id AS tag_id, t.name, t.color\n        FROM monitor_tags mt\n        JOIN tags t ON t.id = mt.tag_id\n        WHERE mt.monitor_id = ANY($1)\n        ORDER BY t.name\n        ",

{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, ts, title, description, service, created_at\n        FROM deploy_markers\n        WHERE ts > now() - make_interval(hours => $1)\n          AND ($2::text IS NULL OR service IS NULL OR service = $2)\n        ORDER BY ts DESC\n        LIMIT 500\n        ",

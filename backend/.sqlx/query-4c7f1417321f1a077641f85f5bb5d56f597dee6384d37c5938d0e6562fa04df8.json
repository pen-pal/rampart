{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT date_trunc('hour', ts) AS \"hour!\", COUNT(*) AS \"count!\"\n        FROM audit_log\n        WHERE action = 'auth.login_failed'\n          AND ts >= now() - make_interval(hours => $1)\n        GROUP BY 1\n        ORDER BY 1\n        ",

  "query": "\n        SELECT w.start_at, w.end_at, w.recurrence\n        FROM maintenance_windows w\n        JOIN maintenance_window_monitors m ON m.window_id = w.id\n        WHERE m.monitor_id = $1\n          AND w.active\n        ",

{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            monitor_id,\n            ts,\n            status AS \"status: MonitorStatus\",\n            latency_ms,\n            status_code,\n            msg,\n            retries,\n            important\n        FROM (\n            SELECT\n                monitor_id, ts, status, latency_ms, status_code, msg, retries, important,\n                ROW_NUMBER() OVER (PARTITION BY monitor_id ORDER BY ts DESC) AS rn\n            FROM heartbeats\n        ) t\n        WHERE rn <= $1\n        ORDER BY monitor_id, ts ASC\n        ",

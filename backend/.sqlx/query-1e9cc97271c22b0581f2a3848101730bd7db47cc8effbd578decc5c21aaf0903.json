  "query": "\n        SELECT mn.monitor_id, COUNT(*)::int8 AS \"count!\"\n        FROM monitor_notifications mn\n        JOIN notifications n ON n.id = mn.notification_id\n        WHERE n.active AND n.org_id = $1\n        GROUP BY mn.monitor_id\n        ",

  "query": "\n        SELECT p.id, p.name, p.steps AS \"steps!\", p.created_at,\n               COUNT(m.id) AS monitor_count\n        FROM escalation_policies p\n        LEFT JOIN monitors m ON m.escalation_policy_id = p.id\n        GROUP BY p.id\n        ORDER BY p.created_at\n        ",

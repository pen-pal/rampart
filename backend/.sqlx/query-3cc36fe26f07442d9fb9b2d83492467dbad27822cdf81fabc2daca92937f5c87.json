  "query": "\n        SELECT id, status_page_id, channel, destination, confirmed,\n               confirm_token, subscribed_at\n        FROM status_page_subscribers\n        WHERE status_page_id = $1\n          AND channel = 'email'\n          AND lower(destination) = lower($2)\n        ",

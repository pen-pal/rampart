  "query": "\n        SELECT p.id, p.name, p.steps AS \"steps!\", p.created_at,\n               COUNT(m.id) AS monitor_count\n        FROM escalation_policies p\n        LEFT JOIN monitors m ON m.escalation_policy_id = p.id\n        WHERE p.id = $1\n        GROUP BY p.id\n        ",

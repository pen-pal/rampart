{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.id, s.monitor_id, m.name AS \"monitor_name?\",\n               s.reason, s.created_at, s.expires_at\n        FROM silences s\n        LEFT JOIN monitors m ON m.id = s.monitor_id\n        WHERE s.expires_at IS NULL OR s.expires_at > now()\n        ORDER BY s.created_at DESC\n        ",

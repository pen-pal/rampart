  "query": "\n        UPDATE escalation_episodes\n        SET resolved_at = NOW()\n        WHERE monitor_id = $1 AND resolved_at IS NULL\n        RETURNING id, monitor_id, subject_kind, subject_ref, policy_id, started_at, last_step,\n                  next_escalation_at, acked_at, acked_by, resolved_at\n        ",

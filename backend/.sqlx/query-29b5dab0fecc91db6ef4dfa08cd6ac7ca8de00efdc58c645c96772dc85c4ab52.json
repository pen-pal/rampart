  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, name, key_prefix, scope, created_by,\n               created_at, last_used_at, expires_at, rate_limit_per_hour,\n               org_id AS \"org_id!\"\n        FROM api_keys\n        WHERE key_hash = $1\n          AND (expires_at IS NULL OR expires_at > NOW())\n        ",

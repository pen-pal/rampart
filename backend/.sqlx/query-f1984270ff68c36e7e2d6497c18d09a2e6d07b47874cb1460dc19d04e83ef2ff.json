{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            TO_TIMESTAMP(FLOOR(EXTRACT(EPOCH FROM ts) / $5) * $5) AS \"bucket!\",\n            AVG(value)  AS \"avg!\",\n            MIN(value)  AS \"min!\",\n            MAX(value)  AS \"max!\",\n            COUNT(*)    AS \"samples!\"\n        FROM metric_samples\n        WHERE name = $1 AND labels = $2 AND ts >= $3 AND ts <= $4 AND org_id = $6\n        GROUP BY 1\n        ORDER BY 1\n        ",

  "db_name": "PostgreSQL",
  "query": "\n        SELECT m.user_id, u.email::text AS \"email!\", u.name,\n               m.role AS \"role: Role\", m.created_at\n        FROM org_members m\n        JOIN users u ON u.id = m.user_id\n        WHERE m.org_id = $1\n        ORDER BY m.created_at ASC\n        ",

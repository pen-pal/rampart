{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.id, a.name, a.location, a.version, a.last_seen_at, a.created_at,\n               a.org_id AS \"org_id!\", COUNT(m.id) AS monitor_count\n        FROM agents a\n        LEFT JOIN monitors m ON m.agent_id = a.id\n        WHERE a.org_id = $1\n        GROUP BY a.id\n        ORDER BY a.created_at\n        ",

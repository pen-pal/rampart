  "query": "\n        SELECT\n            monitor_id,\n            COUNT(*)                              AS \"total!\",\n            COUNT(*) FILTER (WHERE status = 'up') AS \"ok_count!\"\n        FROM heartbeats\n        WHERE monitor_id = ANY($1) AND ts >= $2\n        GROUP BY monitor_id\n        ",

  "query": "\n        SELECT\n            monitor_id,\n            AVG(latency_ms)::float8 AS avg\n        FROM heartbeats\n        WHERE monitor_id = ANY($1) AND ts >= $2 AND status = 'up' AND latency_ms IS NOT NULL\n        GROUP BY monitor_id\n        ",

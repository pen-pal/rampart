  "query": "\n        SELECT id, name, key_prefix, scopes, created_by,\n               created_at, last_used_at, expires_at\n        FROM api_keys\n        WHERE key_hash = $1\n          AND (expires_at IS NULL OR expires_at > NOW())\n        ",

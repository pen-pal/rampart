{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            received_at,\n            service_name,\n            profile_type,\n            period_ns,\n            duration_ns,\n            sample_count,\n            labels AS \"labels!: serde_json::Value\"\n        FROM profiles\n        WHERE received_at >= now() - make_interval(hours => $1)\n          AND ($2::text IS NULL OR service_name = $2)\n          AND ($3::text IS NULL OR profile_type = $3)\n          AND org_id = $5\n        ORDER BY received_at DESC\n        LIMIT $4\n        ",

  "query": "\n        SELECT severity, COUNT(*) AS \"count!\"\n        FROM logs\n        WHERE received_at > now() - make_interval(hours => $1)\n          AND ($2::text IS NULL OR service_name = $2)\n        GROUP BY severity\n        ",

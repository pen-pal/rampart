  "query": "\n        SELECT id, issue_id, project_id, ts, level, message, exception_type, culprit,\n               environment, release, server_name, stacktrace, context\n        FROM error_events\n        WHERE issue_id = $1\n        ORDER BY ts DESC\n        LIMIT $2\n        ",

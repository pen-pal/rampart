  "query": "\n        SELECT id, slug, title, description, theme, custom_domain, logo_url, custom_css,\n               (password_hash IS NOT NULL) AS \"private!\", created_at\n        FROM status_pages\n        WHERE ($1::uuid IS NULL OR org_id = $1)\n        ORDER BY created_at DESC\n        ",

{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT m.org_id,\n               o.slug AS org_slug,\n               o.name AS org_name,\n               m.user_id,\n               u.email::text AS \"email!\",\n               u.name,\n               m.role AS \"role: Role\",\n               m.created_at AS member_since,\n               u.last_login_at,\n               u.totp_enabled\n        FROM org_members m\n        JOIN users u ON u.id = m.user_id\n        JOIN organizations o ON o.id = m.org_id\n        ORDER BY o.name, u.email\n        ",

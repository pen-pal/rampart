  "query": "\n        SELECT\n            id, status_page_id, title, content,\n            style AS \"style: IncidentStyle\",\n            pinned, active, resolved_at, created_at, created_by\n        FROM incidents\n        WHERE status_page_id = $1 AND active\n        ORDER BY pinned DESC, created_at DESC\n        ",
